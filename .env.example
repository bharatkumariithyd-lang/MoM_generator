# Copy this file to ".env" and paste your real Groq API key below.
# Get a free key at: https://console.groq.com/keys
#
# IMPORTANT: never commit your real .env file to git.

GROQ_API_KEY=your_groq_api_key_here

# OPTIONAL — only for --speakers pyannote (high-accuracy diarization).
# This is your Hugging Face ACCESS TOKEN (starts with "hf_"). First accept the
# model terms at https://huggingface.co/pyannote/speaker-diarization-community-1,
# then create a token with "Read access to contents of all public gated repos"
# at https://huggingface.co/settings/tokens and paste it here:
# HF_TOKEN=hf_your_token_here

# OPTIONAL — a MIRROR URL (NOT a token!). Only if your network blocks
# huggingface.co. Leave commented otherwise:
# HF_ENDPOINT=https://hf-mirror.com
