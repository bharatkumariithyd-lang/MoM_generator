# Copy this file to ".env" and paste your real Groq API key below.
# Get a free key at: https://console.groq.com/keys
#
# IMPORTANT: never commit your real .env file to git.

GROQ_API_KEY=your_groq_api_key_here

# OPTIONAL: only needed if your network/ISP blocks huggingface.co (the site
# faster-whisper downloads its model from). Uncomment to use a public mirror:
# HF_ENDPOINT=https://hf-mirror.com
